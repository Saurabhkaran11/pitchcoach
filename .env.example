# AI keys belong to the visitor. They paste their own Gemini and Boson keys in the app. Do not set them here.
# All owner settings below are optional.
# LLM_MODEL=gemini-3.6-flash
# LLM_FALLBACK_MODEL=gemini-flash-latest
# GITHUB_TOKEN=      read-only token that raises the GitHub rate limit for public repos
# WAITLIST_WEBHOOK=  where waitlist emails go. Without it they stay in the visitor's browser
# ALLOWED_ORIGINS=   extra hostnames allowed to call the API routes
